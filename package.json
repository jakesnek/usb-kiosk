{
  "name": "usb-kiosk",
  "version": "2.2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.4jd.usbkiosk",
    "productName": "USB Kiosk",
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true
    }
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.0",
    "bootstrap-icons": "^1.13.1",
    "drivelist": "^12.0.2",
    "heic-convert": "^2.1.0",
    "mammoth": "^1.11.0",
    "node-gyp": "^11.4.2",
    "pdfjs-dist": "^5.4.449",
    "python": "^0.0.4",
    "xlsx": "^0.18.5"
  }
}
